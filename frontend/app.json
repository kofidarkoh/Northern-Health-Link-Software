{
  "expo": {
    "name": "Northern Health Link",
    "slug": "northern-health-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.northernhealthlink.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate to access patient data"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D3E18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.northernhealthlink.app",
      "usesCleartextTraffic": false,
      "networkSecurityConfig": "./config/network-security-config.xml"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Northern Health Link to use Face ID for authentication."
        }
      ]
    ]
  }
}
