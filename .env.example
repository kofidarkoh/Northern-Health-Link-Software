# ============================================
# Northern Health Link — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32

# MySQL (local development)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nhls_dev
MYSQL_USER=root
MYSQL_PASSWORD=

# MySQL (production — Aiven.io)
# MYSQL_HOST=your-aiven-host.aivencloud.com
# MYSQL_PORT=25060
# MYSQL_DATABASE=defaultdb
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your-password
# MYSQL_SSL_CA=/path/to/ca-cert.pem

# Redis (caching, rate limiting, SocketIO)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# File Upload
UPLOAD_FOLDER=uploads/lab_results
MAX_CONTENT_LENGTH=16777216

# Frontend (Expo)
# EXPO_PUBLIC_API_URL=http://localhost:5000
